# ---------------------------------------------------------------------------
# Supabase project settings
# Find these in your Supabase project: Project Settings -> API
# ---------------------------------------------------------------------------

# Public URL of your Supabase project
NEXT_PUBLIC_SUPABASE_URL=https://YOUR-PROJECT-REF.supabase.co

# Public "anon" key (safe to expose to the browser, protected by RLS)
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key

# SECRET service-role key. NEVER expose this to the browser.
# Used only in server-side API routes (src/app/api/**) for privileged
# operations such as accepting/rejecting applications.
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# Name of the Supabase Storage bucket used for screenshots (create it in
# Supabase Storage and set it to "private" -- signed URLs are used to view).
NEXT_PUBLIC_SUPABASE_SCREENSHOTS_BUCKET=screenshots

# ---------------------------------------------------------------------------
# Gift code auto-redeem (talks to KingShot's own gift-code API)
# ---------------------------------------------------------------------------

# Signing salt used by KingShot's gift-code API. Not a per-user secret --
# it's a static value baked into the game client itself.
KINGSHOT_GIFTCODE_SECRET=mN4!pQs6JrYwV9

# Key for the unofficial community gift-code list (ks-gift-code-api.whiteout-bot.com),
# used to auto-discover new codes. A shared, hardcoded value from the public
# Kingshot-Discord-Bot repo -- not a real per-user secret either.
GIFT_CODE_COMMUNITY_API_KEY=super_secret_bot_token_nobody_will_ever_find

# Your own random secret protecting /api/gift-codes/sync from public abuse.
# Generate one (e.g. `openssl rand -hex 24`) and put the SAME value in your
# GitHub repo's Actions secrets as GIFT_CODE_SYNC_SECRET.
GIFT_CODE_SYNC_SECRET=generate-your-own-random-value
